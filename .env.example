# ==========================================
# 1. APPLICATION CONFIGURATION
# ==========================================
APP_NAME="CustomFormBuilder"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ==========================================
# 2. DATABASE CONFIGURATION
# (Secara default diatur ke sqlite untuk pengujian lokal langsung,
# ganti ke pgsql jika server PostgreSQL & pdo_pgsql telah aktif)
# ==========================================
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=form_builder_db
# DB_USERNAME=postgres
# DB_PASSWORD=secret_password

# ==========================================
# 3. REDIS & QUEUE (CACHE & BACKGROUND JOBS)
# Untuk dev lokal Windows gunakan file / sync (atau ubah ke redis jika service Redis aktif)
# ==========================================
CACHE_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

# Predis digunakan agar kompatibel dengan PHP Windows tanpa ekstensi C phpredis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ==========================================
# 4. GOOGLE OAUTH 2.0 (LOGIN DASHBOARD & SPREADSHEETS CONSENT)
# Dapatkan dari Google Cloud Console -> APIs & Services -> Credentials
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Batasi domain email yang boleh login (kosongkan jika publik)
# Contoh: itbad.ac.id
GOOGLE_ALLOWED_DOMAIN=

# ==========================================
# 5. GOOGLE SHEETS API (SERVICE ACCOUNT SENTRAL)
# Path menuju file credentials JSON dari Google Cloud Service Account (opsional jika menggunakan OAuth)
# ==========================================
GOOGLE_APPLICATION_CREDENTIALS=storage/credentials/google-service-account.json

# Cache TTL untuk Remote Data Dropdown (dalam detik, default 15 menit)
SPREADSHEET_CACHE_TTL=900

# ==========================================
# 6. WEBHOOKS & SECURITY
# ==========================================
# Secret default jika pengguna tidak mendefinisikan secret kustom pada form
DEFAULT_WEBHOOK_SECRET=super_secret_webhook_key_random
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=3

# ==========================================
# 7. STORAGE & FILE UPLOAD
# ==========================================
FILESYSTEM_DISK=public
MAX_UPLOAD_SIZE_MB=10

